# Copie este arquivo para ".env" e preencha. NUNCA suba o .env para o GitHub.

# Login do sistema
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
SECRET_KEY=troque-por-um-texto-aleatorio-grande

# Chave da API do Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Repositório no GitHub (usuario/repositorio) — mostra o último commit na tela principal
GITHUB_REPO=
GITHUB_BRANCH=main

# Banco de dados. Vazio = SQLite local (adm_financeiro.db). Em produção use PostgreSQL:
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
DATABASE_URL=
